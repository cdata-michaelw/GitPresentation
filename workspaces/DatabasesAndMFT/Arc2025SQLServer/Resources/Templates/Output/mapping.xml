<Items>
    <app_logs table="`dbo`.`app_logs`">
        <type />
        <id type="integer" key="true" />
        <instanceid />
        <message />
        <pattern_id type="bigint" />
        <script />
        <timestamp type="datetime" />
    </app_logs>
